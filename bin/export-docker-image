#!/usr/bin/env bash
set -euo pipefail

# Export a tagged image to a tarball for offline installs.
#
# Usage:
#   ./bin/export-docker-image [image:tag] [output.tar]
#
# Example:
#   ./bin/export-docker-image rps:latest /tmp/rps_image.tar

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

IMAGE="${1:-ghcr.io/nyepaul/rps:latest}"
OUT="${2:-/tmp/rps_image.tar}"

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker is not installed or not on PATH." >&2
  exit 1
fi

echo "[export] image: $IMAGE"
echo "[export] output: $OUT"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "ERROR: image not found locally: $IMAGE" >&2
  echo "Build it first, for example:" >&2
  echo "  docker build -f docker/Dockerfile -t $IMAGE ." >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"
docker save "$IMAGE" -o "$OUT"

echo "[export] wrote: $OUT"
echo "Next (on the target machine):"
echo "  docker load -i $OUT"
