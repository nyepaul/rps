#!/bin/bash
# Bump version number in centralized config and cache-busting

if [ $# -eq 0 ]; then
    echo "Usage: ./bin/bump-version <new_version> [release_notes]"
    echo "Example: ./bin/bump-version 3.10.0 'Add new feature X'"
    exit 1
fi

NEW_VERSION=$1
RELEASE_NOTES=${2:-"Bug fixes and improvements"}
# Use UTC date for consistency across environments/timezones.
RELEASE_DATE=$(date -u +%Y-%m-%d)

# Update centralized version.json
cat > src/static/version.json <<EOF
{
    "version": "$NEW_VERSION",
    "release_date": "$RELEASE_DATE",
    "release_notes": "$RELEASE_NOTES"
}
EOF

# Update index.html and login.html cache-busting parameter (keep this build-time update)
sed -i "s|/js/main.js?v=.*\"|/js/main.js?v=$NEW_VERSION\"|g" src/static/index.html
sed -i "s|/js/login.js?v=.*\"|/js/login.js?v=$NEW_VERSION\"|g" src/static/login.html

# Update version in core documentation files
echo "📖 Updating documentation files..."
SEMVER_PATTERN='[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*'
sed -i "s|Version: $SEMVER_PATTERN|Version: $NEW_VERSION|g" GEMINI.md
sed -i "s|\*\*Version\*\*: $SEMVER_PATTERN|**Version**: $NEW_VERSION|g" README.md
sed -i "s|(Current: $SEMVER_PATTERN)|(Current: $NEW_VERSION)|g" CLAUDE.md
sed -i "s|Version\*\*: $SEMVER_PATTERN|Version**: $NEW_VERSION|g" GEMINI.md 2>/dev/null || true
sed -i "s|RPS Version\*\*: $SEMVER_PATTERN|RPS Version**: $NEW_VERSION|g" docs/ai-integration/GEMINI.md
sed -i "s|Version:\*\* $SEMVER_PATTERN|Version:** $NEW_VERSION|g" docs/security/SYSTEM_SECURITY_DOCUMENTATION.md
sed -i "s|Version: $SEMVER_PATTERN|Version: $NEW_VERSION|g" docs/security/AUDIT_LOGGING.md
sed -i "s|v3\.9\.[0-9]* reorganized|v$NEW_VERSION reorganized|g" docs/architecture/PROJECT_STRUCTURE.md

echo "✅ Version bumped to $NEW_VERSION"
echo "📅 Release date: $RELEASE_DATE"
echo "📝 Notes: $RELEASE_NOTES"
echo ""
echo "Modified files:"
echo "  - src/static/version.json"
echo "  - src/static/index.html (cache busting)"
echo ""
echo "Don't forget to commit and deploy:"
echo "  git add src/static/version.json src/static/index.html"
echo "  git commit -m 'chore: bump version to $NEW_VERSION'"
echo "  git push"
echo "  sudo ./bin/deploy"
