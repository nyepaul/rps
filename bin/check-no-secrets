#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "Running secret pattern scan..."

# High-signal patterns for common credential leaks.
PATTERN='(AIza[0-9A-Za-z_-]{35}|sk-(proj-)?[A-Za-z0-9]{20,}|REDACTED_ANTH_[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{36}|AKIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH|PRIVATE) KEY-----)'

# Scan tracked text files only and skip known non-source artifact directories.
if git grep -nE "$PATTERN" -- . ':(exclude).git' ':(exclude)venv' ':(exclude)node_modules' ':(exclude)dist' ':(exclude)build'; then
    echo
    echo "ERROR: potential secret-like tokens detected. Remove or replace before push."
    exit 1
fi

echo "No secret-like tokens found."
