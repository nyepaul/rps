#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${1:-https://rps.pan2.app}"
TMP_HTML="$(mktemp /tmp/rps_ui_links_html.XXXXXX)"
TMP_LIST="$(mktemp /tmp/rps_ui_links_list.XXXXXX)"
TMP_RESP="$(mktemp /tmp/rps_ui_links_resp.XXXXXX)"

pass=0
fail=0

pass_case() { printf '[PASS] %s\n' "$1"; pass=$((pass + 1)); }
fail_case() { printf '[FAIL] %s\n' "$1"; fail=$((fail + 1)); }

curl_retry() {
  # Some environments have flaky IPv6/AAAA resolution; retry forcing IPv4 on DNS errors.
  local rc out attempt max_attempts
  local url hostport host port ip
  local -a extra
  max_attempts="${RPS_CURL_RETRIES:-4}"

  # Prefer pinning an IPv4 via --resolve to avoid curl resolver flakiness.
  url="${@: -1}"
  hostport="${url#*://}"
  hostport="${hostport%%/*}"
  host="${hostport%%:*}"
  port="${hostport##*:}"
  if [[ -n "$host" && "$host" == "$hostport" ]]; then
    port=443
  fi
  if [[ -n "$host" ]]; then
    if [[ "$host" == "rps.pan2.app" ]]; then
      # Hardcode known Cloudflare A records to avoid DNS flakiness.
      extra=( -4 )
    else
      # Use getent (more likely to work in constrained environments than dig).
      ip="$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1{print $1}' || true)"
      if [[ -n "$ip" ]]; then
        extra=( -4 --resolve "${host}:${port}:${ip}" )
      else
        extra=( -4 )
      fi
    fi
  else
    extra=( -4 )
  fi

  attempt=1
  while [[ "$attempt" -le "$max_attempts" ]]; do
    # Always alternate between known Cloudflare A records for rps.pan2.app (avoid DNS + single-IP failures).
    if [[ "$host" == "rps.pan2.app" ]]; then
      if (( attempt % 2 == 1 )); then
        extra=( -4 --resolve "${host}:${port}:104.21.44.217" )
      else
        extra=( -4 --resolve "${host}:${port}:172.67.203.239" )
      fi
    fi

    set +e
    out=$(curl "${extra[@]}" "$@")
    rc=$?
    set -e

    if [[ "$rc" -eq 0 ]]; then
      printf '%s' "$out"
      return 0
    fi

    # Backoff: 0.2s, 0.4s, 0.6s, ...
    sleep "$(python3 - <<PY
print(f"{0.2 * $attempt:.1f}")
PY
)"
    attempt=$((attempt + 1))
  done

  # Keep the caller running under set -e; treat as "no response".
  printf '000'
  return 0
}

check_path() {
  local path="$1"
  local code
  code=$(curl_retry -sS -o "$TMP_RESP" -w '%{http_code}' -H "Referer: ${BASE_URL}/" -H "Origin: ${BASE_URL}" "${BASE_URL}${path}")
  if [[ "$code" =~ ^2|3 ]]; then
    pass_case "${path} (${code})"
  else
    fail_case "${path} (${code})"
  fi
}

cleanup() {
  rm -f "$TMP_HTML" "$TMP_LIST" "$TMP_RESP"
}
trap cleanup EXIT

for page in / /login; do
  code=$(curl_retry -sS -o "$TMP_HTML" -w '%{http_code}' "${BASE_URL}${page}")
  if [[ ! "$code" =~ ^2|3 ]]; then
    fail_case "page ${page} (${code})"
    continue
  fi
  pass_case "page ${page} (${code})"

  # Extract local href/src paths only
  grep -Eo '(href|src)="[^"]+"' "$TMP_HTML" \
    | sed -E 's/^(href|src)="//; s/"$//' \
    | grep -E '^/' \
    | grep -Ev '^//|^/api/|^/logout|^/login\?' \
    | sort -u > "$TMP_LIST" || true

  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    check_path "$p"
  done < "$TMP_LIST"

done

# Static tab/button wiring checks from source
python3 - <<'PY'
from pathlib import Path
import re
import sys

index = Path('src/static/index.html').read_text(encoding='utf-8')
main_js = Path('src/static/js/main.js').read_text(encoding='utf-8')

tabs = sorted(set(re.findall(r'data-tab="([^"]+)"', index)))
missing = [t for t in tabs if f"case '{t}':" not in main_js]

if missing:
    print('[FAIL] tab handlers missing in main.js:', ', '.join(missing))
    sys.exit(2)
print(f"[PASS] tab handlers present for {len(tabs)} tabs")
PY

printf 'SUMMARY base=%s pass=%s fail=%s\n' "$BASE_URL" "$pass" "$fail"
[[ "$fail" -eq 0 ]]
