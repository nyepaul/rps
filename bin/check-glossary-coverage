#!/usr/bin/env python3
"""Lightweight audit for glossary/help coverage in key finance tabs."""

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent

CHECKS = {
    "src/static/js/components/tax/tax-tab.js": [
        "g('Ladder Years', 'ladder_years')",
        "g('Safety Buffer ($)', 'safety_buffer')",
        "g('Life Expectancy', 'life_expectancy')",
        "g('Primary Optimal Age', 'primary_optimal_age')",
        "g('Survivor Income (70 Strategy)', 'survivor_income_70')",
        "g('RMD Analysis', 'rmd')",
    ],
    "src/static/js/components/withdrawal/withdrawal-tab.js": [
        "glossaryTerm('Withdrawal Rate', 'withdrawal_rate')",
        "glossaryTerm('Tax-Efficient', 'tax_efficient_sequence')",
        "glossaryTerm('Taxable', 'taxable')",
        "glossaryTerm('Deferred', 'tax_deferred')",
        "glossaryTerm('Roth', 'roth')",
    ],
    "src/static/js/components/dashboard/dashboard-tab.js": [
        "dashboardGlossaryTerm('Social Security', 'social_security')",
        "dashboardGlossaryTerm('Medicare', 'medicare')",
        "dashboardGlossaryTerm('Required Minimum Distributions', 'rmd')",
        "dashboardGlossaryTerm('Net Worth', 'net_worth')",
        "dashboardGlossaryTerm('Liquidity', 'liquidity')",
    ],
    "src/static/js/components/comparison/comparison-tab.js": [
        "glossaryHeader('SUCCESS', 'success_rate')",
        "glossaryHeader('MEDIAN', 'median')",
        "glossaryHeader('5TH %', 'percentile_5')",
        "glossaryHeader('95TH %', 'percentile_95')",
    ],
}


def main() -> int:
    missing = []

    for rel_path, snippets in CHECKS.items():
        file_path = ROOT / rel_path
        if not file_path.exists():
            missing.append(f"{rel_path}: file not found")
            continue

        content = file_path.read_text()
        for snippet in snippets:
            if snippet not in content:
                missing.append(f"{rel_path}: missing `{snippet}`")

    if missing:
        print("Glossary coverage check FAILED:")
        for line in missing:
            print(f" - {line}")
        return 1

    print("Glossary coverage check passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
