#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

ENV_FILE="${ROOT}/.env"

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker is not installed or not on PATH." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "ERROR: docker compose is not available (Docker Desktop / docker-compose v2 required)." >&2
  exit 1
fi

RPS_HOST_PORT="${RPS_HOST_PORT:-5137}"

if [[ -f "$ENV_FILE" ]]; then
  echo "[setup] .env already exists; leaving it unchanged: $ENV_FILE"
else
  echo "[setup] creating .env"
  echo "[setup] generating SECRET_KEY and ENCRYPTION_KEY using Docker (no host deps)..."

  secrets="$(
    docker run --rm python:3.11-slim python - <<'PY'
import secrets, string
alphabet = string.ascii_letters + string.digits + "!@#$%^&*()-_=+"
def gen(n=64):
    return "".join(secrets.choice(alphabet) for _ in range(n))
print("SECRET_KEY=" + gen())
print("ENCRYPTION_KEY=" + gen())
PY
  )"

  cat > "$ENV_FILE" <<EOF
# RPS localhost Docker install (.env)
# Generated by bin/docker-setup
${secrets}
EOF

  echo "[setup] wrote $ENV_FILE"
fi

echo "[setup] starting services (redis + rps) on http://127.0.0.1:${RPS_HOST_PORT}"
docker compose up -d

echo "[setup] done"
echo "Next:"
echo "  - View logs: docker compose logs -f rps"
echo "  - Stop:      docker compose down"
