#!/usr/bin/env bash
set -euo pipefail

# Stable test entrypoint that always uses the repo virtualenv.
# Avoids accidentally running system pytest (which may miss dependencies).

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -x "./venv/bin/python" ]]; then
  echo "ERROR: venv not found. Run ./bin/start first to create it." >&2
  exit 2
fi

exec ./venv/bin/python -m pytest "$@"

