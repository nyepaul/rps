#!/usr/bin/env bash
set -euo pipefail

# Stable test entrypoint that always uses the repo virtualenv.
# Avoids accidentally running system pytest (which may miss dependencies).

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -x "./venv/bin/python" ]]; then
  echo "venv not found; creating ./venv and installing dev requirements..." >&2
  python3 -m venv ./venv
  ./venv/bin/pip install --quiet --upgrade pip
  ./venv/bin/pip install --quiet -r config/requirements-dev.txt
fi

exec ./venv/bin/python -m pytest "$@"
