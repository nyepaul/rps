#!/usr/bin/env python3
import secrets
import string

def generate_secret(length=64):
    # Use alphanumeric and basic punctuation for maximum compatibility
    alphabet = string.ascii_letters + string.digits + "!@#$%^&*()-_=+"
    return ''.join(secrets.choice(alphabet) for _ in range(length))

print("=== RPS Secure Secret Generator ===")
print("\nGenerated SECRET_KEY:")
print(generate_secret())
print("\nGenerated ENCRYPTION_KEY:")
print(generate_secret())
print("\nUpdate your .env or environment variables with these values.")
