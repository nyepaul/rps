#!/bin/bash
###############################################################################
# RPS Management Script
#
# Unified management interface for the Retirement Planning System.
# Features: error handling, logging, and robust command execution.
#
# Author: pan
# Updated: 2026-01-25
###############################################################################

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOG_DIR="${PROJECT_ROOT}/logs"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Ensure log directory exists
mkdir -p "${LOG_DIR}"

# Logging function
log() {
    local level=$1
    shift
    local message="$*"
    local timestamp="$(date +"%Y-%m-%d %H:%M:%S")"

    # Log to file (if writable)
    if [[ -w "${LOG_DIR}" ]]; then
        echo "[${timestamp}] [${level}] ${message}" >> "${LOG_DIR}/manage.log"
    fi

    # Log to console with colors
    case $level in
        INFO) echo -e "${BLUE}[INFO]${NC} ${message}" ;;
        SUCCESS) echo -e "${GREEN}[SUCCESS]${NC} ${message}" ;;
        WARNING) echo -e "${YELLOW}[WARNING]${NC} ${message}" ;;
        ERROR) echo -e "${RED}[ERROR]${NC} ${message}" ;;
        *) echo "[${level}] ${message}" ;;
    esac
}

# Error handler
error_exit() {
    log ERROR "$1"
    exit 1
}

# Trap errors (disabled for functions that handle their own errors)
# trap 'error_exit "Command failed at line $LINENO"' ERR

show_help() {
    echo "Retirement Planning System - Management CLI"
    echo ""
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  start         Start application (Docker compose)"
    echo "  start-docker  Alias for start"
    echo "  stop          Stop application"
    echo "  restart       Restart application"
    echo "  logs          View application logs"
    echo "  tunnel        Start Cloudflare tunnel"
    echo "  backup        Run comprehensive backup"
    echo "  restore       Restore from backup"
    echo "  status        Check system status"
    echo "  clean         Remove all data (WARNING!)"
    echo "  skills        List available planning skills"
    echo "  reset-token   Generate password reset token"
    echo ""
}

start_simple() {
    # Docker-only runtime: keep legacy command working by delegating.
    start_docker
}

start_docker() {
    log INFO "Starting application in Docker (docker compose)..."
    cd "${PROJECT_ROOT}"

    if ! command -v docker >/dev/null 2>&1; then
        error_exit "docker is not installed or not on PATH"
    fi

    if ! docker compose version >/dev/null 2>&1; then
        error_exit "docker compose is not available (Docker Desktop / compose v2 required)"
    fi

    # Prefer dev compose file (builds from source). For image-only installs, use docker-compose.yml directly.
    if [[ -f "${PROJECT_ROOT}/docker-compose.dev.yml" ]]; then
        docker compose -f docker-compose.dev.yml up -d --build
    else
        docker compose up -d
    fi

    local port="${RPS_HOST_PORT:-5137}"
    log SUCCESS "Application started at http://127.0.0.1:${port}"
}

stop_app() {
    log INFO "Stopping application..."
    cd "${PROJECT_ROOT}"

    if ! command -v docker >/dev/null 2>&1; then
        log WARNING "docker not available; nothing to stop"
        return
    fi

    if ! docker compose version >/dev/null 2>&1; then
        log WARNING "docker compose not available; nothing to stop"
        return
    fi

    # Prefer dev compose file when present.
    if [[ -f "${PROJECT_ROOT}/docker-compose.dev.yml" ]]; then
        docker compose -f docker-compose.dev.yml down || true
    fi
    docker compose down || true
    log SUCCESS "Docker compose stopped"
}

view_logs() {
    cd "${PROJECT_ROOT}"
    if [[ -f "${PROJECT_ROOT}/docker-compose.dev.yml" ]]; then
        docker compose -f docker-compose.dev.yml logs -f rps
    else
        docker compose logs -f rps
    fi
}

start_tunnel() {
    log INFO "Starting Cloudflare Tunnel..."
    if ! command -v cloudflared &> /dev/null;
    then
        error_exit "cloudflared not found. Please install it first."
    fi
    cloudflared tunnel --url http://127.0.0.1:5137
}

backup_data() {
    log INFO "Delegating to backup script..."
    "${PROJECT_ROOT}/bin/backup" "$@"
}

restore_data() {
    log INFO "Delegating to restore script..."
    "${PROJECT_ROOT}/bin/restore" "$@"
}

clean_all() {
    echo -e "${RED}WARNING: This will delete ALL data and containers!${NC}"
    echo -n "Type 'yes' to confirm: "
    read confirm
    
    if [[ "$confirm" == "yes" ]]; then
        stop_app
        rm -rf "${PROJECT_ROOT}/data/"*
        rm -rf "${PROJECT_ROOT}/venv"
        rm -rf "${PROJECT_ROOT}/src/venv"
        log SUCCESS "System cleaned successfully"
    else
        log INFO "Operation cancelled"
    fi
}

check_status() {
    echo "Application Status"
    echo "=================="

    cd "${PROJECT_ROOT}"
    if docker compose version >/dev/null 2>&1; then
        if [[ -f "${PROJECT_ROOT}/docker-compose.dev.yml" ]]; then
            docker compose -f docker-compose.dev.yml ps
        else
            docker compose ps
        fi

        local port="${RPS_HOST_PORT:-5137}"
        echo ""
        if curl -s "http://127.0.0.1:${port}/health" > /dev/null 2>&1; then
            echo -e "Health check: ${GREEN}OK${NC}"
        else
            echo -e "Health check: ${YELLOW}NOT READY${NC}"
        fi
    else
        echo -e "docker compose: ${RED}NOT AVAILABLE${NC}"
    fi
    
    echo ""
    echo "Database:"
    if [[ -f "${PROJECT_ROOT}/data/planning.db" ]]; then
        local size=$(du -h "${PROJECT_ROOT}/data/planning.db" | cut -f1)
        echo -e "  Size: ${BLUE}${size}${NC}"
    else
        echo -e "  ${YELLOW}Not initialized${NC}"
    fi
}

view_skills() {
    echo "Available Planning Skills"
    echo "========================="
    for skill in "${PROJECT_ROOT}/skills/"*-SKILL.md;
    do
        if [[ -f "$skill" ]]; then
            basename "$skill" | sed 's/-SKILL.md//'
        fi
    done
}

# Main dispatch
case "${1:-}" in
    start)
        start_docker
        ;;
    start-docker)
        start_docker
        ;;
    stop)
        stop_app
        ;;
    restart)
        stop_app
        sleep 2
        start_docker
        ;;
    logs)
        view_logs
        ;;
    tunnel)
        start_tunnel
        ;;
    backup)
        shift
        backup_data "$@"
        ;;
    restore)
        shift
        restore_data "$@"
        ;;
    clean)
        clean_all
        ;;
    status)
        check_status
        ;;
    skills)
        view_skills
        ;;
    reset-token)
        shift
        "${PROJECT_ROOT}/venv/bin/python3" "${PROJECT_ROOT}/bin/generate-reset-token" "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
