#!/usr/bin/env bash
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

SOURCE_DIR="/home/paul/src/rps"
TARGET_DIR="/var/www/rps.pan2.app"
ENV_FILE="$TARGET_DIR/.env"
ENV_PROD_FILE="$TARGET_DIR/.env.production"

usage() {
  cat <<EOF
Usage: sudo ./bin/fix-env-and-deploy [--env-file /path/to/.env] [--skip-deploy]

Fixes common env syntax issues that break deploy validation, validates .env files,
then runs ./bin/deploy by default.
EOF
}

fix_common_quoting() {
  local file="$1"
  local tmp_file
  tmp_file="$(mktemp)"

  awk '
BEGIN { changed=0 }
/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=/ {
  key=substr($0, 1, index($0, "=")-1)
  val=substr($0, index($0, "=")+1)
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)

  if (key == "MAIL_DEFAULT_SENDER" || key == "SECRET_KEY" || key == "ENCRYPTION_KEY") {
    if (val !~ /^".*"$/ && val !~ /^'\''.*'\''$/) {
      gsub(/\\/,"\\\\",val)
      gsub(/"/,"\\\"",val)
      gsub(/\$/,"\\$",val)
      gsub(/`/,"\\`",val)
      print key "=\"" val "\""
      changed=1
      next
    }
  }
}
{ print }
END {
  if (changed == 1) {
    print "# fix-env-and-deploy: normalized quoting for common sensitive keys in file" > "/dev/stderr"
  }
}
' "$file" > "$tmp_file"

  mv "$tmp_file" "$file"
}

validate_env_syntax() {
  local file="$1"
  echo -e "${YELLOW}→ Validating shell syntax: ${file}${NC}"
  if bash -n "$file"; then
    echo -e "  ${GREEN}✓ Syntax valid${NC}"
  else
    echo -e "${RED}  ✗ Syntax invalid: ${file}${NC}"
    nl -ba "$file" | sed -n '1,30p'
    exit 1
  fi
}

SKIP_DEPLOY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      ENV_FILE="${2:-}"
      shift 2
      ;;
    --skip-deploy)
      SKIP_DEPLOY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo -e "${RED}Unknown argument: $1${NC}"
      usage
      exit 1
      ;;
  esac
done

if [[ $EUID -ne 0 ]]; then
  echo -e "${RED}Run as root/sudo:${NC} sudo ./bin/fix-env-and-deploy"
  exit 1
fi

if [[ ! -f "$ENV_FILE" && ! -f "$ENV_PROD_FILE" ]]; then
  echo -e "${RED}Missing env files.${NC} Expected at least one of:"
  echo "  $ENV_FILE"
  echo "  $ENV_PROD_FILE"
  exit 1
fi

for file in "$ENV_FILE" "$ENV_PROD_FILE"; do
  [[ -f "$file" ]] || continue

  echo -e "${YELLOW}→ Backing up ${file}...${NC}"
  backup_file="${file}.bak.$(date +%Y%m%d_%H%M%S)"
  cp "$file" "$backup_file"
  echo -e "  ${GREEN}✓ Backup:${NC} $backup_file"

  echo -e "${YELLOW}→ Normalizing line endings: ${file}${NC}"
  sed -i 's/\r$//' "$file"

  echo -e "${YELLOW}→ Fixing common key quoting: ${file}${NC}"
  fix_common_quoting "$file"
  echo -e "  ${GREEN}✓ Common quoting checks complete${NC}"

  validate_env_syntax "$file"
done

echo -e "${YELLOW}→ Validating combined source/load behavior...${NC}"
if bash -lc "set -a; [ -f '$ENV_FILE' ] && source '$ENV_FILE'; [ -f '$ENV_PROD_FILE' ] && source '$ENV_PROD_FILE'; set +a; echo OK" >/tmp/fix_env_validate.out 2>/tmp/fix_env_validate.err; then
  echo -e "  ${GREEN}✓ Env files can be sourced${NC}"
else
  echo -e "${RED}  ✗ Env load failed${NC}"
  sed -n '1,120p' /tmp/fix_env_validate.err
  exit 1
fi

if [[ "$SKIP_DEPLOY" -eq 1 ]]; then
  echo -e "${GREEN}Done.${NC} Skipped deploy by request."
  exit 0
fi

echo -e "${YELLOW}→ Running deployment...${NC}"
"$SOURCE_DIR/bin/deploy"
echo -e "${GREEN}✓ Deploy completed${NC}"
