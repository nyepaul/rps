# Copy to .env for localhost Docker installs.
# Generate strong values with:
#   ./bin/docker-setup   (Linux/Mac)
# Or on Windows:
#   powershell -ExecutionPolicy Bypass -File .\\bin\\docker-setup.ps1

SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# Optional email settings (not required if RPS_REQUIRE_EMAIL_VERIFICATION=false)
MAIL_SERVER=127.0.0.1
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=RPS <noreply@localhost>

