# RPS production environment template
# Copy to /var/www/rps.pan2.app/.env and set secure values before deploy.

FLASK_ENV=production
APP_BASE_URL=https://rps.pan2.app
CORS_ORIGINS=https://rps.pan2.app
SESSION_COOKIE_SECURE=true

# Required secrets (replace with real values).
SECRET_KEY=replace-with-strong-random-secret
ENCRYPTION_KEY=replace-with-strong-random-key-material

# Optional: set when using encrypted backup key workflows.
# BACKUP_KEY_PEPPER=replace-with-strong-random-pepper
